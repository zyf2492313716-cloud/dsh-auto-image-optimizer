{
  "name": "@dsh-local/dsh-auto-image-optimizer",
  "version": "0.1.0",
  "description": "DSH 智能图片上传优化插件：自动等比缩小超大 Retina/4K 截屏，杜绝 2000px 报错",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "auto-image-optimizer.cordis.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyf2492313716-cloud/dsh-auto-image-optimizer.git"
  },
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.1.2"
  },
  "dsh": {
    "bundle": {
      "patch": "auto-image-optimizer.cordis.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
